<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ClienteController">
    <children>
        <VBox prefWidth="300.0" spacing="10.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label text="Cadastro / Edição de Cliente" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                <Label text="ID:" />
                <TextField fx:id="txtId" disable="true" promptText="ID (Auto)" />
                <Label text="Nome:" />
                <TextField fx:id="txtNome" />
                <Label text="CPF:" />
                <TextField fx:id="txtCpf" />
                <Label text="Email:" />
                <TextField fx:id="txtEmail" />
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnCadastrar" mnemonicParsing="false" onAction="#cadastrarCliente" text="Salvar Novo" />
                        <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#limparCampos" text="Limpar" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#atualizarCliente" text="Atualizar" />
                        <Button fx:id="btnDeletar" mnemonicParsing="false" onAction="#deletarCliente" style="-fx-background-color: #ff4d4d; -fx-text-fill: white;" text="Deletar" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <TableView fx:id="tabela" prefWidth="500.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNome" prefWidth="150.0" text="Nome" />
                <TableColumn fx:id="colCpf" prefWidth="120.0" text="CPF" />
                <TableColumn fx:id="colEmail" prefWidth="170.0" text="Email" />
            </columns>
        </TableView>
    </children>
</HBox>