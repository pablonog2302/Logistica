<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="450.0" prefWidth="850.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ItensPedidoController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <VBox prefWidth="300.0" spacing="12.0">
            <children>
                <Label text="Itens do Pedido">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>

                <Label text="ID Registro:" />
                <TextField fx:id="txtId" editable="false" style="-fx-background-color: #eee;" />

                <Label text="ID do Pedido (pedido_id):" />
                <TextField fx:id="txtPedidoId" promptText="Ex: 10" />

                <Label text="ID do Produto (produto_id):" />
                <TextField fx:id="txtProdutoId" promptText="Ex: 5" />

                <Label text="Quantidade:" />
                <TextField fx:id="txtQuantidade" promptText="Ex: 50" />

                <Label text="Peso Total Item (kg):" />
                <TextField fx:id="txtPesoTotal" promptText="Ex: 120.50" />

                <HBox spacing="10.0">
                    <children>
                        <Button maxWidth="Infinity" HBox.hgrow="ALWAYS" mnemonicParsing="false" onAction="#cadastrarItem" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Salvar" />
                        <Button maxWidth="Infinity" HBox.hgrow="ALWAYS" mnemonicParsing="false" onAction="#atualizarItem" style="-fx-background-color: #FFC107; -fx-text-fill: black;" text="Editar" />
                        <Button maxWidth="Infinity" HBox.hgrow="ALWAYS" mnemonicParsing="false" onAction="#deletarItem" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Excluir" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#limparCampos" style="-fx-background-color: #9E9E9E; -fx-text-fill: white;" text="Limpar Campos" />
            </children>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" spacing="10.0">
            <children>
                <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colPedidoId" prefWidth="100.0" text="ID Pedido" />
                        <TableColumn fx:id="colProdutoId" prefWidth="100.0" text="ID Produto" />
                        <TableColumn fx:id="colQuantidade" prefWidth="100.0" text="Quantidade" />
                        <TableColumn fx:id="colPesoTotal" prefWidth="140.0" text="Peso Total" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</HBox>