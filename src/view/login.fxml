<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="350.0" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 40;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
    <children>
        <Label text="LOGIN SISTEMA" textFill="WHITE">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <VBox spacing="5.0">
            <children>
                <Label text="Usuário:" textFill="WHITE" />
                <TextField fx:id="txtUsuario" style="-fx-background-color: #34495e; -fx-text-fill: white;" />
            </children>
        </VBox>
        <VBox spacing="5.0">
            <children>
                <Label text="Senha:" textFill="WHITE" />
                <PasswordField fx:id="txtSenha" style="-fx-background-color: #34495e; -fx-text-fill: white;" />
            </children>
        </VBox>
        <Button maxWidth="Infinity" onAction="#efetuarLogin" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Entrar">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>
    </children>
</VBox>